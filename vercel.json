{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "survival.cornmc.vn"
        }
      ],
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "survival.cornmc.vn"
        }
      ],
      "src": "/(.*)",
      "dest": "/survival/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "smp.cornmc.vn"
        }
      ],
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "smp.cornmc.vn"
        }
      ],
      "src": "/(.*)",
      "dest": "/smp/$1"
    }
  ]
}
